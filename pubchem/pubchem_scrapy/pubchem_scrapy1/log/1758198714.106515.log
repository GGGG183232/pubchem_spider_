<h2>Abstract</h2>
<div html="" itemprop="content"><abstract lang="EN" load-source="patent-office" mxw-id="PA674360765">
<div class="abstract" id="pa01" num="0001">The present invention relates to methods of preventing, inhibiting, delaying, and/or mitigating seizures by administration of a steroid, <i>e.g.,</i> a neurosteroid, <i>e</i>.<i>g</i>., allopregnanolone.</div>
</abstract>
</div>
</section>
